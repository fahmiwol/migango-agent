{
  "name": "migango",
  "version": "0.2.0-alpha.29",
  "type": "module",
  "description": "miganGO: a local-first desktop AI agent that runs on the hardware you already own and asks before it spends.",
  "main": "src/desktop/main.mjs",
  "scripts": {
    "build-native": "node scripts/build-native.mjs",
    "postinstall": "node scripts/setup.mjs",
    "prestart": "node scripts/build-native.mjs --if-missing",
    "start": "electron .",
    "test": "node --test tests/unit/*.test.mjs",
    "test:desktop": "node --test tests/integration/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:renew": "node scripts/verify.mjs --renew-seal",
    "verify:evidence": "node scripts/verify-evidence.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "commonmark": "0.31.2",
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Fahmi Ghani <fahmiwol@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/fahmiwol/migango-agent.git"
  },
  "keywords": [
    "ai-agent",
    "local-first",
    "ollama",
    "byok",
    "electron",
    "mcp",
    "cost-control",
    "bahasa-indonesia"
  ]
}
